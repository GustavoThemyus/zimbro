# Copie para .env e ajuste. O .env nao vai para o git.

# Local: http://localhost. Producao: o dominio, sem esquema, para o Caddy
# emitir o certificado (ex.: app.seudominio.com.br).
DOMINIO=http://localhost

# Porta no SEU computador. 5433 porque 5432 costuma estar ocupado por outro
# projeto. Dentro do docker os servicos sempre falam na 5432.
DB_PORT=5433

DB_NAME=zimbro
DB_USER=zimbro
# Em producao: troque por algo gerado com `openssl rand -base64 24`.
DB_PASSWORD=zimbro

# --- E-mail -----------------------------------------------------------------
# 'log' escreve o link de recuperacao de senha no log do servidor: serve para
# desenvolver, e NAO serve para cliente real (quem esquece a senha fica trancado
# fora). Troque para 'smtp' e preencha o resto antes do primeiro MEI.
EMAIL_MODO=log

# Precisa ser um endereco do SEU dominio, com SPF/DKIM configurados no
# provedor — remetente de dominio alheio (gmail.com) e barrado ou vai para spam.
# Como o dominio do Zimbro ainda nao existe, isto fica pendente junto com ele.
EMAIL_REMETENTE=Zimbro <nao-responda@exemplo.com.br>

# Credenciais do provedor (Resend, Brevo, Amazon SES, Mailgun...). A porta 587
# usa STARTTLS, que e o que o application.properties espera.
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_SENHA=
